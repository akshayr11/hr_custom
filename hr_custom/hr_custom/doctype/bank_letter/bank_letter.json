  },
  {
   "fieldname": "all_departments",
   "fieldtype": "Check",
   "label": "All Departments",
   "default": "0",
   "depends_on": "eval:(doc.based_on=='Department' || (doc.based_on=='Cost Center' && doc.head_office_selected))"
  },
  {
   "fieldname": "departments",
   "fieldtype": "Table MultiSelect",
   "label": "Departments",

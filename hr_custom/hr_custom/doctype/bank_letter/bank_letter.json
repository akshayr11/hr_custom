  },
  {
   "fieldname": "cost_centers",
   "fieldtype": "Table MultiSelect",
   "label": "Cost Centers",
   "options": "Bank Letter Cost Center",
   "depends_on": "eval:doc.based_on=='Cost Center' && !doc.all_cost_centers",
   "mandatory_depends_on": "eval:doc.based_on=='Cost Center' && !doc.all_cost_centers",

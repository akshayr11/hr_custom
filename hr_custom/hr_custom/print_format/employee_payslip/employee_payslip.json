{
 "align_labels_right": 0,
 "creation": "2026-10-23 10:00:00.000000",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Salary Slip",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 0,
 "html": "{%- set p = get_payslip_data(doc) -%}\n{%- set emp = p.employee -%}\n{%- macro amt(value) -%}{{ frappe.utils.fmt_money(value) if value else \"0\" }}{%- endmacro -%}\n{%- macro num(value) -%}{{ \"%g\" | format(frappe.utils.flt(value, 2)) if value else \"0\" }}{%- endmacro -%}\n<style>\n\t.payslip { font-size: 11px; color: #000; }\n\t.payslip table { width: 100%; border-collapse: collapse; }\n\t.payslip td { padding: 2px 4px; border: none; vertical-align: top; }\n\t.payslip .box { border: 1px solid #000; margin-top: 8px; }\n\t.payslip .head td { padding: 1px 4px; }\n\t.payslip .head td.label { width: 42%; text-align: right; padding-right: 20px; font-weight: 700; }\n\t.payslip .head td.value { font-weight: 700; }\n\t.payslip .center { text-align: center; }\n\t.payslip .num { text-align: right; padding-right: 30px; }\n\t.payslip .title { font-weight: 700; font-size: 12px; text-align: center; margin: 8px 0 4px; }\n\t.payslip .status { display: inline-block; min-width: 90px; border: 1px solid #000; text-align: center; font-weight: 700; padding: 1px 8px; }\n\t.payslip .ed th { border: 1px solid #000; text-align: center; padding: 8px; font-weight: 700; }\n\t.payslip .ed td.col { width: 50%; border: 1px solid #000; padding: 0; }\n\t.payslip .ed td.col td { padding: 3px 4px; }\n\t.payslip .details { font-size: 10px; padding: 0 6px 4px; }\n\t.payslip .totals td { border: 1px solid #000; font-weight: 700; padding: 6px 4px; }\n</style>\n<div class=\"payslip\">\n\t<table class=\"head\">\n\t\t<tr><td colspan=\"2\" class=\"center\" style=\"font-weight:700; padding-bottom:4px\">{{ _(\"To be Opened by Addressee Only\") }}</td></tr>\n\t\t<tr><td class=\"label\">{{ _(\"Emp No\") }}</td><td class=\"value\">{{ doc.employee }}</td></tr>\n\t\t<tr><td class=\"label\">{{ _(\"Name\") }}</td><td class=\"value\">{{ doc.employee_name }}</td></tr>\n\t\t<tr><td class=\"label\">{{ _(\"Designation\") }}</td><td class=\"value\">{{ emp.designation or \"\" }}</td></tr>\n\t\t<tr><td class=\"label\">{{ _(\"Department\") }}</td><td class=\"value\">{{ emp.department or \"\" }}</td></tr>\n\t\t<tr><td class=\"label\">{{ _(\"Location\") }}</td><td class=\"value\">{{ emp.location or \"\" }}</td></tr>\n\t\t<tr><td class=\"label\">{{ _(\"Bank Name\") }}</td><td class=\"value\">{{ emp.bank_name or \"\" }}</td></tr>\n\t\t<tr><td class=\"label\">{{ _(\"Bank Account No\") }}:</td><td class=\"value\">{{ emp.bank_ac_no or \"\" }}</td></tr>\n\t</table>\n\n\t<div class=\"title\">{{ _(\"PAY SLIP\") }}</div>\n\t<table class=\"box\">\n\t\t<tr>\n\t\t\t<td style=\"width:33%\">{{ _(\"Basic Pay\") }}: {{ amt(p.basic_pay) }}</td>\n\t\t\t<td style=\"width:34%\">{{ _(\"Allowances\") }}: {{ amt(p.allowances) }}</td>\n\t\t\t<td style=\"width:33%\">{{ _(\"Total Pay\") }}: {{ amt(p.total_pay) }}</td>\n\t\t</tr>\n\t</table>\n\n\t<table style=\"margin-top:6px\">\n\t\t<tr>\n\t\t\t<td style=\"width:25%\"></td>\n\t\t\t<td class=\"center\" style=\"font-weight:700\">{{ _(\"FOR THE MONTH OF\") }} {{ p.month }}</td>\n\t\t\t<td style=\"width:25%; text-align:right; font-weight:700; font-size:13px\">\n\t\t\t\t{{ _(\"Status\") }}:\n\t\t\t\t<span class=\"status\" style=\"color: {{ '#c62828' if doc.status == 'Withheld' else '#2e7d32' }}\">{{ p.status }}</span>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n\n\t{%- set a = p.attendance -%}\n\t<table class=\"box\">\n\t\t<tr>\n\t\t\t<td>{{ _(\"No of Days Worked\") }}:</td><td>{{ num(a.days_worked) }}</td>\n\t\t\t<td>{{ _(\"Annual Leave\") }}:</td><td>{{ num(a.annual_leave) }}</td>\n\t\t\t<td>{{ _(\"Unpaid\") }}:</td><td>{{ num(a.unpaid) }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>{{ _(\"Absent Days\") }}:</td><td>{{ num(a.absent_days) }}</td>\n\t\t\t<td>{{ _(\"Sick Days\") }}:</td><td>{{ num(a.sick_days) }}</td>\n\t\t\t<td>{{ _(\"OT Hours\") }}:</td><td>{{ num(a.ot_hours) }}</td>\n\t\t</tr>\n\t\t<tr style=\"border-top:1px solid #000\">\n\t\t\t<td>{{ _(\"No of Rest Days\") }}:</td><td>{{ a.rest_days }}</td>\n\t\t\t<td colspan=\"4\"></td>\n\t\t</tr>\n\t</table>\n\n\t<table class=\"ed\" style=\"margin-top:12px\">\n\t\t<tr><th style=\"width:50%\">{{ _(\"Earnings\") }}</th><th>{{ _(\"Deductions\") }}</th></tr>\n\t</table>\n\t<table class=\"ed\" style=\"margin-top:8px\">\n\t\t<tr>\n\t\t\t<td class=\"col\">\n\t\t\t\t<table>\n\t\t\t\t\t{% for label, value in p.earnings %}\n\t\t\t\t\t<tr><td>{{ label }}:</td><td class=\"num\">{{ amt(value) }}</td></tr>\n\t\t\t\t\t{% endfor %}\n\t\t\t\t</table>\n\t\t\t\t<div style=\"margin-top:10px; padding:0 4px; text-decoration: underline\">{{ _(\"Oth Addition Details\") }}</div>\n\t\t\t\t<div class=\"details\">\n\t\t\t\t\t{% for component, value in p.addition_details %}{{ _(\"Other Addition\") }}({{ component }}):{{ amt(value) }}{% if not loop.last %}, {% endif %}{% endfor %}\n\t\t\t\t</div>\n\t\t\t</td>\n\t\t\t<td class=\"col\">\n\t\t\t\t<table>\n\t\t\t\t\t{% for label, value in p.deductions %}\n\t\t\t\t\t<tr><td>{{ label }}:</td><td class=\"num\">{{ amt(value) }}</td></tr>\n\t\t\t\t\t{% endfor %}\n\t\t\t\t</table>\n\t\t\t\t<div style=\"margin-top:10px; padding:0 4px; text-decoration: underline\">{{ _(\"Oth Ded Details\") }}</div>\n\t\t\t\t<div class=\"details\">\n\t\t\t\t\t{% for component, value in p.deduction_details %}{{ _(\"Other Deduction\") }}({{ component }}):{{ amt(value) }}{% if not loop.last %}, {% endif %}{% endfor %}\n\t\t\t\t</div>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n\n\t<table class=\"totals\" style=\"margin-top:4px\">\n\t\t<tr>\n\t\t\t<td style=\"width:30%\">{{ _(\"Gross Sal\") }} :</td>\n\t\t\t<td style=\"width:20%\" class=\"num\">{{ amt(doc.gross_pay) }}</td>\n\t\t\t<td style=\"width:30%\">{{ _(\"Tot Deductions\") }}:</td>\n\t\t\t<td style=\"width:20%\" class=\"num\">{{ amt(doc.total_deduction) }}</td>\n\t\t</tr>\n\t</table>\n\t<table style=\"margin-top:10px\">\n\t\t<tr>\n\t\t\t<td style=\"width:30%; font-weight:700\">{{ _(\"Net Sal\") }} :</td>\n\t\t\t<td style=\"width:20%; font-weight:700\" class=\"num\">{{ amt(doc.net_pay) }}</td>\n\t\t\t<td></td>\n\t\t</tr>\n\t</table>\n</div>\n",
 "idx": 0,
